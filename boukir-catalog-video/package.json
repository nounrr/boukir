{
  "name": "boukir-catalog-video",
  "version": "1.0.0",
  "description": "Catalogue panoramique Boukir Diamond / Kerakoll",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/media": "4.0.534",
    "image-size": "2.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "commercial:render": "remotion render src/index.ts BoukirCommercial out/boukir-commercial-1548x516.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-bitrate=192k --concurrency=2 && node scripts/verify-commercial.mjs",
    "commercial:verify": "node scripts/verify-commercial.mjs",
    "dev": "remotion studio --no-open --port=3100",
    "catalog:refresh": "node scripts/fetch-catalog.mjs",
    "videos:import": "node scripts/prepare-videos.mjs",
    "report": "node scripts/prepare-videos.mjs",
    "test": "node --test scripts/matching.test.mjs",
    "render": "node scripts/prepare-videos.mjs && node scripts/validate-catalog.mjs && remotion render src/index.ts BoukirCatalogue out/boukir-kerakoll-1548x516.mp4 --codec=h264 --crf=18 --concurrency=2",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  }
}
