# # Server
# PORT=3001

# Product price/cache synchronization between the API and the e-commerce frontend.
# Configure the same secret in ecom/.env.production. Do not expose it as NEXT_PUBLIC_*.
ECOMMERCE_FRONTEND_URL=https://boukirdiamond.com
ECOM_REVALIDATE_SECRET=replace-with-a-random-secret
# Optional when the invalidation endpoint uses another internal address:
# ECOM_PRODUCT_REVALIDATE_URL=http://127.0.0.1:3000/internal-seo-cache/revalidate-product

# # MySQL
# DB_HOST=localhost
# DB_PORT=3307
# DB_USER=root
# DB_PASSWORD=rootroot@
# DB_NAME=bpukir
# DB_CONNECTION_LIMIT=10

# Operational service-request notifications
SERVICE_NOTIFY_CLIENT_ASSIGNMENT=false
SERVICE_NOTIFY_CLIENT_COMPLETED=false
SERVICE_NOTIFIABLE_INTERVENTION_STATUSES=en_route,arrived
SERVICE_REQUEST_INITIAL_RESPONSE_SLA_MINUTES=120
