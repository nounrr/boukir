# Server
PORT=3001
NODE_ENV=development

# JWT Secret (set a strong random value in real .env)
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Socket.IO Secret (set a strong random value in real .env)
SOCKET_SECRET=changeme

# Google OAuth (do NOT commit real values)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=boukir
DB_CONNECTION_LIMIT=10

# WhatsApp Service (use env/secret manager for production)
WHTSP_SERVICE_BASE_URL=http://localhost:3600
WHTSP_SERVICE_API_KEY=your-whatsapp-api-key
MAALEM_NOTIFY_UNDER_REVIEW=false

# KAN-20 operational notifications. Client assignment/completion messages are opt-in.
SERVICE_NOTIFY_CLIENT_ASSIGNMENT=false
SERVICE_NOTIFY_CLIENT_COMPLETED=false
SERVICE_NOTIFIABLE_INTERVENTION_STATUSES=en_route,arrived
SERVICE_REQUEST_INITIAL_RESPONSE_SLA_MINUTES=120

# Public base URL for media links
PUBLIC_BASE_URL=http://localhost:5174/
ECOMMERCE_FRONTEND_URL=http://localhost:3002
# Backend environment variables (example)

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=boukir

# JWT
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# App
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Production: exact additional trusted origins only, comma separated (never *).
# The HTTPS apex and www storefront origins are explicitly allowed in corsOrigins.js.
# Preserve any required admin origin in this list when deploying.

# Paiement par carte Chaabi Payment (plateforme CMI) - kit de test
# URL de la passerelle (test). En production, remplacer par l'URL du kit de production.
CMI_GATEWAY_URL=https://test-chaabipayment.cmi.co.ma/fim/est3dgate
# Identifiant marchand (ClientId) fourni par CMI
CMI_CLIENT_ID=820010076
# Clé de hachage : à CHOISIR vous-même dans le back office CMI (Administration -> Changer les clés du magasin)
# puis à recopier ici À L'IDENTIQUE. Ne jamais la committer. Ne doit pas contenir "SKS".
CMI_STORE_KEY=
CMI_CURRENCY=504
# URL publique du backend, joignable depuis Internet par CMI (même en test) : https://api.votre-domaine.ma
CMI_BACKEND_PUBLIC_URL=
# URL publique du site ecom : https://boukirdiamond.com
CMI_SHOP_URL=
# true = débit automatique (ACTION=POSTAUTH). false = confirmation manuelle dans le Merchant Center CMI.
CMI_AUTO_CAPTURE=true
